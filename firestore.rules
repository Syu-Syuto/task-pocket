rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/tasks/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['title','categoryId','due','status','note','createdAt'])
        && request.resource.data.keys().hasOnly(['title','categoryId','due','status','note','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.categoryId is string
        && request.resource.data.due is string && (request.resource.data.due == '' || request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.status in ['todo','doing','done']
        && request.resource.data.note is string && request.resource.data.note.size() <= 5000
        && request.resource.data.createdAt is number;
    }
    match /users/{uid}/categories/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['name','color','order'])
        && request.resource.data.keys().hasOnly(['name','color','order'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.order is number;
    }
  }
}
